; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FPS_Demo"
run/main_scene="uid://cdn317dx8yl4h"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CsgToolkitAutoload="*uid://w8ad8q4lneis"
CyclopsAutoload="*uid://4siqre3jhe80"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/cyclops_level_builder/plugin.cfg", "res://addons/gator_model_studio/plugin.cfg", "res://addons/gator_sprite_studio/plugin.cfg")

